menu "Example Configuration"

config BROKER_URI
    string "MQTT Broker URI"
    default "mqtts://thingsboard.maksonlee.com"
    help
        Set the URI of the MQTT broker to connect to.
        Example: mqtts://mqtt.eclipseprojects.io

config DHT11_GPIO
    int "DHT11 data GPIO"
    range 0 33
    default 23
    help
        Select an available output-capable GPIO. Do not use flash, UART,
        or boot-strapping pins without checking the board wiring.

config TELEMETRY_INTERVAL_SECONDS
    int "Sensor sampling and telemetry interval (seconds)"
    range 3 3600
    default 5
    help
        DHT11 reads must be more than two seconds apart. Failed samples are
        skipped; the same interval applies before trying again.

endmenu
